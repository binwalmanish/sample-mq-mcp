#!/usr/bin/env python3
"""
IBM MQ MCP Tool (Layer 2 of 4)

4-layer architecture:
    [1] Chat UI
         ↓  user question
    [2] MQ MCP Tools  ← THIS FILE
         ↓  HTTP REST calls
    [3] MQ Context Provider  (FastAPI service — mq-context-provider)
         ↓  MCP client via observability-common
    [4] Observability MCP  →  Observe platform (MQ statistics)

This file is ONLY responsible for:
  - Exposing FastMCP tools that the AI chat platform can call
  - Translating tool calls into HTTP requests to the MQ Context Provider
  - Formatting the responses back to the chat user

It does NOT connect to Observe or IBM MQ directly.

Environment variable:
    MQ_CONTEXT_PROVIDER_URL  - Base URL of the mq-context-provider service
                               (default: http://mq-context-provider:8000)
"""

import os
import json

import httpx
from mcp.server.fastmcp import FastMCP

mcp = FastMCP("mq-mcp-tools")

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

MQ_CONTEXT_PROVIDER_URL = os.getenv(
    "MQ_CONTEXT_PROVIDER_URL",
    "http://mq-context-provider:8000",
).rstrip("/")


# ---------------------------------------------------------------------------
# HTTP helper — calls the MQ Context Provider REST API
# ---------------------------------------------------------------------------

async def _get(path: str, params: dict | None = None) -> dict:
    """GET request to the MQ Context Provider."""
    url = f"{MQ_CONTEXT_PROVIDER_URL}{path}"
    async with httpx.AsyncClient(timeout=60.0) as client:
        response = await client.get(url, params=params or {})
        response.raise_for_status()
        return response.json()


def _fmt(data: dict | list) -> str:
    return json.dumps(data, indent=2)


def _handle_error(e: Exception, path: str) -> str:
    if isinstance(e, httpx.ConnectError):
        return f"Cannot reach MQ Context Provider at {MQ_CONTEXT_PROVIDER_URL}{path}\nCheck MQ_CONTEXT_PROVIDER_URL."
    if isinstance(e, httpx.HTTPStatusError):
        if e.response.status_code == 503:
            return "MQ Context Provider is unavailable (503) — Observe platform may be down."
        return f"MQ Context Provider returned {e.response.status_code}: {e.response.text}"
    return f"Unexpected error: {e}"


# ---------------------------------------------------------------------------
# Tools — each maps to one MQ Context Provider endpoint
# ---------------------------------------------------------------------------

@mcp.tool()
async def get_mq_queue_statistics(
    queue_manager: str,
    queue_name: str = "*",
    time_range: str = "1h",
) -> str:
    """
    Get MQ queue depth and statistics for a queue manager.

    Args:
        queue_manager: Queue manager name (e.g. QM1)
        queue_name:    Queue name or pattern — "*" for all queues (default)
        time_range:    Lookback window — "15m", "1h", "24h" (default: "1h")

    Returns:
        Queue depth, message rates, and consumer counts from Observe.
    """
    try:
        data = await _get("/api/v1/mq/queues", {
            "queue_manager": queue_manager,
            "queue": queue_name,
            "time_range": time_range,
        })
        return _fmt(data)
    except Exception as e:
        return _handle_error(e, "/api/v1/mq/queues")


@mcp.tool()
async def get_mq_channel_statistics(
    queue_manager: str,
    channel_name: str = "*",
) -> str:
    """
    Get MQ channel status and statistics for a queue manager.

    Args:
        queue_manager: Queue manager name (e.g. QM1)
        channel_name:  Channel name or pattern — "*" for all (default)

    Returns:
        Channel status, message rates, and connection information from Observe.
    """
    try:
        data = await _get("/api/v1/mq/channels", {
            "queue_manager": queue_manager,
            "channel": channel_name,
        })
        return _fmt(data)
    except Exception as e:
        return _handle_error(e, "/api/v1/mq/channels")


@mcp.tool()
async def get_mq_alerts(
    queue_manager: str = "",
    severity: str = "",
    time_range: str = "24h",
    limit: int | None = None,
) -> str:
    """
    Get active MQ alerts and incidents from Observe.

    Args:
        queue_manager: Filter by queue manager name (leave empty for all)
        severity:      Comma-separated severities — e.g. "Critical,Major" (leave empty for all)
        time_range:    Lookback window — "1h", "24h", "7d" (default: "24h")
        limit:         Max number of alerts to return (leave empty for no limit)

    Returns:
        Active alerts with severity, summary, and first/last occurrence times.
    """
    params: dict = {"time_range": time_range}
    if queue_manager:
        params["queue_manager"] = queue_manager
    if severity:
        params["severity"] = severity
