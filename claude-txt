#!/usr/bin/env python3
"""
IBM MQ MCP Server - Observe MCP Integration

This server acts as an MCP CLIENT to the Observe MCP server to fetch MQ statistics,
then exposes those results as tools for the centralized AI chat platform.

Architecture:
    User Chat  →  This FastMCP server  →  [MCP client]  →  Observe MCP Server
                  (tool provider)          (consumer)        (MQ stats source)

Environment variables (matching observability-common/config.py pattern):
    OBSERVABILITY_MCP_URL      - Observe MCP server URL  (e.g. https://observe-mcp-server.intranet/mcp)
    OBSERVABILITY_MCP_TOKEN    - API token for authentication
    OBSERVABILITY_MCP_TIMEOUT  - Request timeout in seconds (default: 120)
    OBSERVABILITY_MCP_SSL_VERIFY - Verify SSL certificates: "true"/"false" (default: false)

Usage:
    export OBSERVABILITY_MCP_URL="https://observe-mcp-server.intranet/mcp"
    export OBSERVABILITY_MCP_TOKEN="your-token-here"
    uv run mqmcpserver_observe.py
"""

import os
import json

import httpx
from mcp import ClientSession
from mcp.client.streamable_http import streamablehttp_client
from mcp.server.fastmcp import FastMCP
from pydantic import BaseModel, Field

# ---------------------------------------------------------------------------
# Configuration  (mirrors observability-common/config.py ObserveConfig)
# ---------------------------------------------------------------------------

class ObserveConfig(BaseModel):
    """Observe MCP connection configuration — loaded from environment variables."""

    url: str = Field(
        default_factory=lambda: os.getenv(
            "OBSERVABILITY_MCP_URL",
            "https://observe-mcp-server.intranet/mcp",
        )
    )
    token: str = Field(
        default_factory=lambda: os.getenv("OBSERVABILITY_MCP_TOKEN", "")
    )
    timeout: float = Field(
        default_factory=lambda: float(os.getenv("OBSERVABILITY_MCP_TIMEOUT", "120"))
    )
    ssl_verify: bool = Field(
        default_factory=lambda: os.getenv("OBSERVABILITY_MCP_SSL_VERIFY", "false").lower() == "true"
    )


# ---------------------------------------------------------------------------
# Exception  (mirrors observability-common/exceptions.py)
# ---------------------------------------------------------------------------

class ObserveConnectionError(Exception):
    """Raised when the Observe MCP server cannot be reached or rejects the token."""


# ---------------------------------------------------------------------------
# MCP client helper  (mirrors observability-common/client.py)
# ---------------------------------------------------------------------------

def _auth_headers(token: str) -> dict:
    return {"Authorization": f"Bearer {token}"}


async def call_observe_tool(tool_name: str, arguments: dict, config: ObserveConfig) -> str:
    """
    Connect to the Observe MCP server, call one tool, return the text result.

    This opens a fresh connection per call — suitable for low-frequency queries.
    For high-frequency use, refactor to a shared session (see observability-common/client.py).
    """
    try:
        timeout = httpx.Timeout(config.timeout)

        async with streamablehttp_client(
            url=config.url,
            headers=_auth_headers(config.token),
            timeout=timeout,
            httpx_client_factory=lambda **kwargs: httpx.AsyncClient(
                verify=config.ssl_verify, **kwargs
            ),
        ) as (read, write, _):
            async with ClientSession(read, write) as session:
                await session.initialize()
                result = await session.call_tool(tool_name, arguments)

                # Extract text from MCP content blocks
                parts = []
                for block in result.content:
                    if hasattr(block, "text"):
                        parts.append(block.text)
                return "\n".join(parts) if parts else "(no output)"

    except httpx.ConnectError as e:
        raise ObserveConnectionError(f"Cannot reach Observe MCP server at {config.url}: {e}") from e
    except httpx.HTTPStatusError as e:
        if e.response.status_code == 401:
            raise ObserveConnectionError("Authentication failed — check OBSERVABILITY_MCP_TOKEN.") from e
        raise ObserveConnectionError(f"Observe MCP server returned {e.response.status_code}: {e.response.text}") from e


async def list_observe_tools(config: ObserveConfig) -> list[dict]:
    """Return all tools exposed by the Observe MCP server."""
    try:
        timeout = httpx.Timeout(config.timeout)

        async with streamablehttp_client(
            url=config.url,
            headers=_auth_headers(config.token),
            timeout=timeout,
            httpx_client_factory=lambda **kwargs: httpx.AsyncClient(
                verify=config.ssl_verify, **kwargs
            ),
        ) as (read, write, _):
            async with ClientSession(read, write) as session:
                await session.initialize()
                response = await session.list_tools()
                return [
                    {
                        "name": t.name,
                        "description": t.description or "",
                        "inputs": t.inputSchema,
                    }
                    for t in response.tools
                ]

    except httpx.ConnectError as e:
        raise ObserveConnectionError(f"Cannot reach Observe MCP server at {config.url}: {e}") from e


# ---------------------------------------------------------------------------
# FastMCP server — exposes Observe MQ data as tools for the AI chat platform
